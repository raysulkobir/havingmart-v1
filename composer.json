{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^7.3|^8.0",
        "anandsiddharth/laravel-paytm-wallet": "^1.0",
        "barryvdh/laravel-dompdf": "^0.9.0",
        "barryvdh/laravel-ide-helper": "^2.9",
        "fideloper/proxy": "^4.4",
        "gabrielbull/ups-api": "^0.8.0",
        "guzzlehttp/guzzle": "^6.3.1|^7.0.1",
        "instamojo/instamojo-php": "^0.4.0",
        "intervention/image": "^2.5",
        "kingflamez/laravelrave": "*",
        "laracasts/flash": "^3.0",
        "laracon21/colorcodeconverter": "*",
        "laracon21/combinations": "*",
        "laracon21/timezones": "*",
        "laravel/framework": "^8.75",
        "laravel/passport": "^10.1",
        "laravel/sanctum": "^2.11",
        "laravel/socialite": "^5.1",
        "laravel/tinker": "^2.5",
        "laravel/ui": "^3.3",
        "maatwebsite/excel": "^3.1",
        "mehedi-iitdu/core-component-repository": "dev-master",
        "nexmo/laravel": "^2.4",
        "niklasravnsborg/laravel-pdf": "^4.0",
        "paypal/paypal-checkout-sdk": "^1.0",
        "razorpay/razorpay": "^2.0",
        "simplesoftwareio/simple-qrcode": "~4",
        "spatie/laravel-image-optimizer": "^1.3",
        "spatie/laravel-permission": "^4.0",
        "stripe/stripe-php": "^7.50",
        "twilio/sdk": "^6.1",
        "unicodeveloper/laravel-paystack": "^1.0",
        "werneckbh/laravel-qr-code": "^0.1.3"
    },
    "require-dev": {
        "facade/ignition": "^2.5",
        "fakerphp/faker": "^1.9.1",
        "filp/whoops": "^2.0",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^5.0",
        "phpunit/phpunit": "^9.3"
    },
    "autoload": {
        "classmap": [
            "database/seeds",
            "database/factories"
        ],
        "psr-4": {
            "App\\": "app/"
        },
        "files": ["app/Http/Helpers.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": [
            ]
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "ocramius/package-versions": true,
            "composer/package-versions-deprecated": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
