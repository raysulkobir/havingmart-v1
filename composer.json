{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "type": "project",
    "repositories": [
        { "type": "path", "url": "packages/laravel-paystack", "options": { "symlink": false } },
        { "type": "path", "url": "packages/laravelrave", "options": { "symlink": false } }
    ],
    "require": {
        "php": "^8.3",
        "anandsiddharth/laravel-paytm-wallet": "^2.0",
        "barryvdh/laravel-dompdf": "^3.0",
        "barryvdh/laravel-ide-helper": "^3.5",
        "gabrielbull/ups-api": "^2.0",
        "guzzlehttp/guzzle": "^7.8.2|^8.0",
        "instamojo/instamojo-php": "^0.4.0",
        "intervention/image": "^2.7",
        "kingflamez/laravelrave": "*",
        "laracasts/flash": "^3.2",
        "laravel/framework": "^13.0",
        "laravel/passport": "^13.0",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.33",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.6",
        "maatwebsite/excel": "^4.0",
        "mehedi-iitdu/core-component-repository": "dev-master",
        "niklasravnsborg/laravel-pdf": "^4.0",
        "paypal/paypal-checkout-sdk": "^1.0",
        "razorpay/razorpay": "^2.0",
        "simplesoftwareio/simple-qrcode": "~4",
        "spatie/laravel-image-optimizer": "^1.8",
        "spatie/laravel-permission": "^8.0",
        "stripe/stripe-php": "^7.50",
        "twilio/sdk": "^6.1",
        "unicodeveloper/laravel-paystack": "*"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "classmap": [
            "database/seeds",
            "database/factories"
        ],
        "psr-4": {
            "App\\": "app/"
        },
        "files": ["app/Http/Helpers.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": [
            ]
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "ocramius/package-versions": true,
            "composer/package-versions-deprecated": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
